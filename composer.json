{
  "name": "sabri/file21-home-news-feed",
  "description": "Development and release-quality gates for File 21.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.8",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test:phpunit": "phpunit --configuration phpunit.xml.dist",
    "test:phpstan": "phpstan analyse --configuration phpstan.neon.dist --no-progress",
    "test:wpcs": "phpcs -n --standard=phpcs.xml.dist"
  }
}
