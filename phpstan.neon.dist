parameters:
  level: 5
  paths:
    - sabri-complete-home-news-feed.php
    - includes/class-canonical-identity-adapter.php
    - includes/class-composer-permissions.php
    - includes/class-privileged-publishing-policy.php
    - includes/class-legacy-founder-post-migration.php
    - includes/class-integrations.php
    - includes/class-universal-composer-workflow-store.php
    - includes/class-universal-composer-workflow-adapter.php
    - includes/class-universal-composer-publication-adapter.php
    - includes/class-universal-composer-subject-schema-adapter.php
  scanDirectories:
    - includes
  scanFiles:
    - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    - tests/phpstan-file22-contract-stubs.php
  treatPhpDocTypesAsCertain: false
  reportUnmatchedIgnoredErrors: false
  tmpDir: .phpstan-cache
